NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hathor_music
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hathor_music
DB_USER=postgres
DB_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_BULLMQ_URL=redis://localhost:6379/1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
STREAM_TOKEN_EXPIRE=1h

# OAuth credentials (optional future). Password auth is the only path mounted today.
# Do not set FEATURE_OAUTH — that name is not read by server/index.js.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/oauth/google/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CALLBACK_URL=http://localhost:5000/api/auth/oauth/spotify/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# OpenAI (AI routes fall back to rule-based when unset)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (optional fallback)
ANTHROPIC_API_KEY=

# pgvector (used when FEATURE_DISCOVERY is on)
PGVECTOR_DIMENSION=1536

# FFmpeg / HLS paths (media pipeline uses these when FEATURE_MEDIA_PIPELINE is on).
# Progressive signed streams are what the live <audio> player uses; HLS is not the SPA player path.
FFMPEG_PATH=/usr/bin/ffmpeg
HLS_SEGMENT_DURATION=6
HLS_OUTPUT_DIR=./uploads/hls

# WebRTC (not mounted in live rooms UI)
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hathor-music
OTEL_SERVICE_VERSION=2.0.0

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000

# Rate Limiting (server also has fixed limiters; these are documentation defaults)
RATE_LIMIT_API=200
RATE_LIMIT_STREAM=2000
RATE_LIMIT_AUTH=10

# ── Project Olympus feature flags (wired in server/config/features.js + index.js)
# Default ON; set to false / 0 / off / no to disable route mounting / worker.
FEATURE_MEDIA_PIPELINE=true
FEATURE_COMMERCE=true
FEATURE_DISCOVERY=true
FEATURE_SOCIAL=true
FEATURE_INTEL=true
FEATURE_PRIVACY=true
FEATURE_WORKER=true
# Job worker poll interval (ms). Redis, when available, wakes workers sooner.
JOB_POLL_INTERVAL_MS=15000

# Legacy names below are NOT read by the live server route mounter.
# Kept commented so operators do not think flipping them enables OAuth/HLS/stems/WebRTC.
# FEATURE_HLS_STREAMING=true
# FEATURE_STEM_SEPARATION=true
# FEATURE_VECTOR_SEARCH=true
# FEATURE_LLM_PLAYLIST=true
# FEATURE_WEBRTC_VIDEO=true
# FEATURE_ANALYTICS=true
# FEATURE_OAUTH=true
# FEATURE_OTEL=true

# Logging
LOG_LEVEL=info

# Admin
ADMIN_EMAIL=admin@hathor.dev
