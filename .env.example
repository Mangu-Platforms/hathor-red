NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/hathor_music
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hathor_music
DB_USER=postgres
DB_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379
REDIS_BULLMQ_URL=redis://localhost:6379/1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/google/callback

# OAuth - Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CALLBACK_URL=http://localhost:5000/api/v1/auth/oauth/spotify/callback

# OAuth - Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (optional fallback)
ANTHROPIC_API_KEY=

# pgvector
PGVECTOR_DIMENSION=1536

# HLS / FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
HLS_SEGMENT_DURATION=6
HLS_OUTPUT_DIR=./uploads/hls

# WebRTC
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hathor-music
OTEL_SERVICE_VERSION=2.0.0

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000

# Rate Limiting
RATE_LIMIT_API=200
RATE_LIMIT_STREAM=2000
RATE_LIMIT_AUTH=10

# Feature Flags
FEATURE_HLS_STREAMING=true
FEATURE_STEM_SEPARATION=true
FEATURE_VECTOR_SEARCH=true
FEATURE_LLM_PLAYLIST=true
FEATURE_WEBRTC_VIDEO=true
FEATURE_ANALYTICS=true
FEATURE_OAUTH=true
FEATURE_OTEL=true

# Logging
LOG_LEVEL=info

# Admin
ADMIN_EMAIL=admin@hathor.dev