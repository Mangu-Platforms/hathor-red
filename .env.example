# Hathor Music Platform - Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Option 1: Use DATABASE_URL for production (Railway, Render, Supabase)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Option 2: Use individual config for local development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hathor_music
DB_USER=postgres
DB_PASSWORD=
# DATABASE_SSL=false

# Redis
# Option 1: Use REDIS_URL for production
# REDIS_URL=redis://default:pass@host:6379
# Option 2: Use individual config for local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Generate a secure secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d
STREAM_TOKEN_EXPIRE=60s

# CORS
CLIENT_URL=http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# ===========================================
# Colab Enterprise AI (Optional - AI features work in fallback mode without this)
# ===========================================
COLAB_API_ENDPOINT=https://colab.research.google.com/api/v1
COLAB_PROJECT_ID=
COLAB_REGION=us-central1
COLAB_API_KEY=
COLAB_TEXT_MODEL=gemini-pro
COLAB_EMBEDDING_MODEL=text-embedding-004
COLAB_VISION_MODEL=gemini-pro-vision
COLAB_TIMEOUT=30000
COLAB_MAX_RETRIES=3
COLAB_RATE_LIMIT=60
COLAB_TOKEN_LIMIT=100000
COLAB_FEATURE_PLAYLIST=true
COLAB_FEATURE_RECOMMENDATIONS=true
COLAB_FEATURE_MOOD=true
COLAB_FEATURE_SEARCH=true
COLAB_FEATURE_CHAT=true
