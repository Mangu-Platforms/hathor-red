{
  "name": "hathor-red-music-platform",
  "version": "1.0.0",
  "description": "MVP music streaming platform with AI features",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev:legacy": "concurrently \"npm run server\" \"npm run client\"",
    "dev": "turbo run dev || npm run dev:legacy",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "deploy": "docker build -t hathor-music:latest .",
    "build:ci": "turbo run build -- --dry-run || npm run build",
    "install-all": "pnpm install",
    "db:seed": "node database/seed.js",
    "db:generate-audio": "node database/generate-sample-audio.js",
    "db:setup": "npm run db:generate-audio && npm run db:seed",
    "db:reset": "turbo run db:reset || npm run db:setup",
    "test": "jest",
    "test:all": "turbo run test",
    "lint": "eslint . --max-warnings=0",
    "lint:ci": "turbo run lint",
    "type-check": "tsc --noEmit",
    "type-check:ci": "turbo run type-check",
    "validate": "turbo run type-check lint test",
    "prepare": "node -e \"if (process.env.NODE_ENV === 'production') process.exit(0); try { require('husky'); process.exit(1) } catch (e) { process.exit(0) }\" || husky",
    "preflight": "tsc --noEmit && eslint . && audit-ci --critical"
  },
  "keywords": [
    "music",
    "streaming",
    "AI",
    "playlist"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=8.0.0"
  },
  "volta": {
    "node": "18.17.0"
  },
  "packageManager": "pnpm@8.9.0",
  "jest": {
    "testMatch": [
      "**/?(*.)+(spec|test).js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "multer": "2.2.0",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "socket.io": "^4.6.2",
    "uuid": "^11.1.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "audit-ci": "^7.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "turbo": "^2.7.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "ws": "^8.21.0",
      "engine.io": "^6.6.7",
      "socket.io-parser": "^4.2.7",
      "websocket-driver": "^0.7.5",
      "shell-quote": "^1.9.0",
      "serialize-javascript": "^7.0.5",
      "nanoid@<4": "^3.3.18",
      "path-to-regexp@<0.2.0": "^0.1.13",
      "body-parser@<2": "^1.20.6",
      "qs": "^6.15.2",
      "lodash": "^4.18.0",
      "fast-uri@3": "^3.1.5",
      "follow-redirects": "^1.16.0",
      "form-data@4": "^4.0.6",
      "http-proxy-middleware@<3": "^2.0.10",
      "launch-editor": "^2.14.1",
      "picomatch@<3": "^2.3.2",
      "postcss@8": "^8.5.23",
      "react-router": "^7.18.2",
      "react-router-dom": "^7.18.2",
      "uuid@<11": "^11.1.1",
      "webpack-dev-server@5": "^5.2.6",
      "yaml@<2": "^1.10.3",
      "axios": "^1.18.0",
      "multer": "2.2.0",
      "form-data@3": "^3.0.5",
      "picomatch@4": "^4.0.4"
    }
  }
}